@_fed_config()
main reactor  {

    lgsvl_interface = new lgsvl_interface()
    
    
    
    
    
    ns_federate__mpc_controller_0 = new NetworkSender_0<{= 0 =}>()
    ns_federate__behavior_planner_3 = new NetworkSender_1<{= 1 =}>()
    ns_federate__behavior_planner_4 = new NetworkSender_2<{= 2 =}>()
    @_tpoLevel(3)
    ns_federate__global_planner = new NetworkSender_3<{= 3 =}>()
    nr_federate__lgsvl_interface = new NetworkReceiver_12()
    nr_federate__lgsvl_interface_0 = new NetworkReceiver_28()
    _lgsvl_interfacestate_command0 = new _lgsvl_interfacestate_command()
    _lgsvl_interfacevehicle_command0 = new _lgsvl_interfacevehicle_command()
    _lgsvl_interfacestate_command0.port -> lgsvl_interface.state_command
    _lgsvl_interfacevehicle_command0.port -> lgsvl_interface.vehicle_command
    nr_federate__lgsvl_interface.msg -> _lgsvl_interfacestate_command0.port0
    lgsvl_interface.vehicle_kinematic_state -> ns_federate__mpc_controller_0.msg
    lgsvl_interface.vehicle_kinematic_state -> ns_federate__behavior_planner_3.msg
    lgsvl_interface.state_report -> ns_federate__behavior_planner_4.msg
    lgsvl_interface.vehicle_kinematic_state -> ns_federate__global_planner.msg
    nr_federate__lgsvl_interface_0.msg -> _lgsvl_interfacevehicle_command0.port0
}
