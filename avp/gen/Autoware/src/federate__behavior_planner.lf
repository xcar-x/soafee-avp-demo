target CCpp {
  build-type: "Release",
  cmake-include: [
      "../../../src/behavior_planner/include/CMakeListsExtension.txt",
      "include/federate__behavior_planner_extension.cmake"],
  compile-definitions: {
    FEDERATED_DECENTRALIZED: "",
    EXECUTABLE_PREAMBLE: "",
    _LF_CLOCK_SYNC_PERIOD_NS: "5000000",
    NUMBER_OF_FEDERATES: "20",
    FEDERATE_ID: "10",
    _LF_CLOCK_SYNC_ATTENUATION: "10",
    _LF_CLOCK_SYNC_COLLECT_STATS: "",
    FEDERATED: "",
    LF_CLOCK_SYNC: "2",
    _LF_CLOCK_SYNC_INITIAL: "",
    _LF_FEDERATE_NAMES_COMMA_SEPARATED: "\"federate__lanelet2_visualizer,federate__filter_and_transform__0,federate__filter_and_transform__1,federate__point_cloud_fusion,federate__voxel_grid_downsampler,federate__ray_ground_classifier,federate__euclidean_cluster_detector,federate__ndt_map_publisher,federate__p2d_ndt_localizer,federate__off_map_obstacles_filter,federate__behavior_planner,federate__parking_planner,federate__lane_planner,federate__global_planner,federate__object_collision_estimator,federate__lgsvl_interface,federate__mpc_controller,federate__robot_state_publisher,federate__map_provider,federate__rviz2\"",
    _LF_CLOCK_SYNC_EXCHANGES_PER_INTERVAL: "10"
  },
  coordination: "decentralized",
  docker: {
    no-build: true,
    builder-base: "openadkit",
    env-file: "env_file",
    runner-base: "",
    rti-image: "xronosinc/rti:v0.9.0",
    pre-build-script: "container-environment.sh",
    pre-run-script: "container-environment.sh",
    post-build-script: "",
    docker-compose-override: ""
  },
  _fed_setup: "include/_federate__behavior_planner_preamble.h",
  files: [
      "../../../Autoware-support",
      "../../../config",
      "../../../cyclonedds.xml",
      "../../../src/include/constants.hpp",
      "../../../src/include/utils.hpp"],
  keepalive: true,
  single-threaded: false,
  trace-plugin: "telegraf_lf_trace_plugin",
  tracing: true
}
import behavior_planner from "../../../src/behavior_planner/behavior_planner_main.lf"

NONE preamble {=
#include "lanelet2_core/LaneletMap.h"
#include "had_map_utils/had_map_conversion.hpp"
#include "had_map_utils/had_map_query.hpp"
#include "autoware_auto_msgs/msg/vehicle_kinematic_state.hpp"
#include "autoware_auto_msgs/msg/vehicle_state_report.hpp"
#include "autoware_auto_msgs/msg/vehicle_state_command.hpp"
#include "behavior_planner.hpp"
#include "behavior_planner_node.hpp"
#include "utils.hpp"
#include "constants.hpp"
=}
preamble {=
#ifdef __cplusplus
extern "C" {
#endif
#include "core/federated/federate.h"
#include "core/federated/network/net_common.h"
#include "core/federated/network/net_util.h"
#include "core/federated/clock-sync.h"
#include "core/threaded/reactor_threaded.h"
#include "core/utils/util.h"
extern federate_instance_t _fed;
#ifdef __cplusplus
}
#endif
#include "rcutils/allocator.h"
#include "rclcpp/rclcpp.hpp"
#include "rclcpp/serialization.hpp"
#include "rclcpp/serialized_message.hpp"

=}

reactor _behavior_plannerglobal_path {
  input port0: std::shared_ptr<autoware_auto_msgs::msg::Route>

  output[1] port: std::shared_ptr<autoware_auto_msgs::msg::Route>

  port0 -> port
}
reactor _behavior_plannermap {
  input port0: std::shared_ptr<autoware_auto_msgs::msg::HADMapBin>

  output[1] port: std::shared_ptr<autoware_auto_msgs::msg::HADMapBin>

  port0 -> port
}
reactor _behavior_plannervehicle_kinematic_state {
  input port0: std::shared_ptr<autoware_auto_msgs::msg::VehicleKinematicState>

  output[1] port: std::shared_ptr<autoware_auto_msgs::msg::VehicleKinematicState>

  port0 -> port
}
reactor _behavior_plannervehicle_state_report {
  input port0: std::shared_ptr<autoware_auto_msgs::msg::VehicleStateReport>

  output[1] port: std::shared_ptr<autoware_auto_msgs::msg::VehicleStateReport>

  port0 -> port
}
reactor _behavior_plannerlane_trajectory {
  input port0: std::shared_ptr<autoware_auto_msgs::msg::Trajectory>

  output[1] port: std::shared_ptr<autoware_auto_msgs::msg::Trajectory>

  port0 -> port
}
reactor _behavior_plannerparking_trajectory {
  input port0: std::shared_ptr<autoware_auto_msgs::msg::Trajectory>

  output[1] port: std::shared_ptr<autoware_auto_msgs::msg::Trajectory>

  port0 -> port
}
reactor _behavior_plannermodified_trajectory {
  input port0: std::shared_ptr<autoware_auto_msgs::msg::Trajectory>

  output[1] port: std::shared_ptr<autoware_auto_msgs::msg::Trajectory>

  port0 -> port
}
@_networkReactor("sender")
reactor NetworkSender_0<SENDERINDEXPARAMETER> {
  input[1] msg: std::shared_ptr<autoware_auto_msgs::srv::HADMapService_Request>

  reaction(msg) {=
    // Sending from msg[0] in federate federate__behavior_planner to map_provider.request in federate federate__map_provider
    if (!msg[0]->is_present) {
    return;
    }
    rclcpp::SerializedMessage serialized_message(0u);
    using MessageT = autoware_auto_msgs::srv::HADMapService_Request;
    static rclcpp::Serialization<MessageT> _lf_serializer;
    _lf_serializer.serialize_message(msg[0]->value.get() , &serialized_message);
    size_t _lf_message_length = serialized_message.size();
    lf_send_message(MSG_TYPE_P2P_MESSAGE, 2, 18, "federate 18", _lf_message_length, serialized_message.get_rcl_serialized_message().buffer);
  =}
}
@_networkReactor("sender")
reactor NetworkSender_1<SENDERINDEXPARAMETER> {
  input[1] msg: std::shared_ptr<autoware_auto_msgs::msg::VehicleStateCommand>

  reaction(msg) {=
    // Sending from msg[0] in federate federate__behavior_planner to lgsvl_interface.state_command in federate federate__lgsvl_interface
    if (!msg[0]->is_present) {
    return;
    }
    rclcpp::SerializedMessage serialized_message(0u);
    using MessageT = autoware_auto_msgs::msg::VehicleStateCommand;
    static rclcpp::Serialization<MessageT> _lf_serializer;
    _lf_serializer.serialize_message(msg[0]->value.get() , &serialized_message);
    size_t _lf_message_length = serialized_message.size();
    lf_send_tagged_message(self->base.environment, 39000000, MSG_TYPE_P2P_TAGGED_MESSAGE, 0, 15, "federate 15", _lf_message_length, serialized_message.get_rcl_serialized_message().buffer);
  =}
}
