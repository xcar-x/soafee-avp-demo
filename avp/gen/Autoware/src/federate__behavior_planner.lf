@_fed_config()
main reactor  {

    behavior_planner = new behavior_planner()
    
    
    
    
    
    ns_federate__map_provider_1 = new NetworkSender_0<{= 0 =}>()
    ns_federate__lgsvl_interface = new NetworkSender_1<{= 1 =}>()
    @_tpoLevel(5)
    ns_federate__lane_planner = new NetworkSender_2<{= 2 =}>()
    @_tpoLevel(5)
    ns_federate__parking_planner = new NetworkSender_3<{= 3 =}>()
    @_tpoLevel(5)
    ns_federate__object_collision_estimator_0 = new NetworkSender_4<{= 4 =}>()
    @_tpoLevel(13)
    ns_federate__mpc_controller = new NetworkSender_5<{= 5 =}>()
    nr_federate__behavior_planner = new NetworkReceiver_18()
    nr_federate__behavior_planner_0 = new NetworkReceiver_19()
    nr_federate__behavior_planner_1 = new NetworkReceiver_22()
    nr_federate__behavior_planner_2 = new NetworkReceiver_23()
    nr_federate__behavior_planner_3 = new NetworkReceiver_25()
    nr_federate__behavior_planner_4 = new NetworkReceiver_26()
    nr_federate__behavior_planner_5 = new NetworkReceiver_32()
    _behavior_plannerglobal_path0 = new _behavior_plannerglobal_path()
    _behavior_plannermap0 = new _behavior_plannermap()
    _behavior_plannervehicle_kinematic_state0 = new _behavior_plannervehicle_kinematic_state()
    _behavior_plannervehicle_state_report0 = new _behavior_plannervehicle_state_report()
    _behavior_plannerlane_trajectory0 = new _behavior_plannerlane_trajectory()
    _behavior_plannerparking_trajectory0 = new _behavior_plannerparking_trajectory()
    _behavior_plannermodified_trajectory0 = new _behavior_plannermodified_trajectory()
    _behavior_plannerglobal_path0.port -> behavior_planner.global_path
    _behavior_plannermap0.port -> behavior_planner.map
    _behavior_plannervehicle_kinematic_state0.port -> behavior_planner.vehicle_kinematic_state
    _behavior_plannervehicle_state_report0.port -> behavior_planner.vehicle_state_report
    _behavior_plannerlane_trajectory0.port -> behavior_planner.lane_trajectory
    _behavior_plannerparking_trajectory0.port -> behavior_planner.parking_trajectory
    _behavior_plannermodified_trajectory0.port -> behavior_planner.modified_trajectory
    behavior_planner.map_request -> ns_federate__map_provider_1.msg
    behavior_planner.vehicle_state_command -> ns_federate__lgsvl_interface.msg
    behavior_planner.lane_route -> ns_federate__lane_planner.msg
    behavior_planner.parking_route -> ns_federate__parking_planner.msg
    behavior_planner.original_trajectory -> ns_federate__object_collision_estimator_0.msg
    behavior_planner.control_trajectory -> ns_federate__mpc_controller.msg
    nr_federate__behavior_planner.msg -> _behavior_plannerparking_trajectory0.port0
    nr_federate__behavior_planner_0.msg -> _behavior_plannerlane_trajectory0.port0
    nr_federate__behavior_planner_1.msg -> _behavior_plannerglobal_path0.port0
    nr_federate__behavior_planner_2.msg -> _behavior_plannermodified_trajectory0.port0
    nr_federate__behavior_planner_3.msg -> _behavior_plannervehicle_kinematic_state0.port0
    nr_federate__behavior_planner_4.msg -> _behavior_plannervehicle_state_report0.port0
    nr_federate__behavior_planner_5.msg -> _behavior_plannermap0.port0
}
