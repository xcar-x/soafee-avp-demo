@_fed_config()
main reactor  {

    map_provider = new lanelet2_map_provider(num_requestors=6)
    
    
    
    
    
    ns_federate__parking_planner_0 = new NetworkSender_0<{= 0 =}>()
    ns_federate__global_planner_0 = new NetworkSender_1<{= 1 =}>()
    ns_federate__lanelet2_visualizer = new NetworkSender_2<{= 2 =}>()
    ns_federate__behavior_planner_5 = new NetworkSender_3<{= 3 =}>()
    ns_federate__off_map_obstacles_filter_0 = new NetworkSender_4<{= 4 =}>()
    ns_federate__lane_planner_0 = new NetworkSender_5<{= 5 =}>()
    nr_federate__map_provider = new NetworkReceiver_0()
    nr_federate__map_provider_0 = new NetworkReceiver_9()
    nr_federate__map_provider_1 = new NetworkReceiver_11()
    nr_federate__map_provider_2 = new NetworkReceiver_17()
    nr_federate__map_provider_3 = new NetworkReceiver_20()
    nr_federate__map_provider_4 = new NetworkReceiver_21()
    _map_providerrequest0 = new _map_providerrequest()
    _map_providerrequest0.port -> map_provider.request
    nr_federate__map_provider.msg -> _map_providerrequest0.port0
    nr_federate__map_provider_0.msg -> _map_providerrequest0.port5
    nr_federate__map_provider_1.msg -> _map_providerrequest0.port1
    nr_federate__map_provider_2.msg -> _map_providerrequest0.port3
    nr_federate__map_provider_3.msg -> _map_providerrequest0.port2
    nr_federate__map_provider_4.msg -> _map_providerrequest0.port4
    map_provider.map -> ns_federate__parking_planner_0.msg
    map_provider.map -> ns_federate__global_planner_0.msg
    map_provider.map -> ns_federate__lanelet2_visualizer.msg
    map_provider.map -> ns_federate__behavior_planner_5.msg
    map_provider.map -> ns_federate__off_map_obstacles_filter_0.msg
    map_provider.map -> ns_federate__lane_planner_0.msg
}
