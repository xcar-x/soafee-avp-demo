@_networkReactor("sender")
reactor NetworkSender_0<SENDERINDEXPARAMETER> {
  input[6] msg: std::shared_ptr<autoware_auto_msgs::msg::HADMapBin>

  reaction(msg) {=
    // Sending from msg[3] in federate federate__map_provider to parking_planner.map in federate federate__parking_planner
    if (!msg[3]->is_present) {
    return;
    }
    rclcpp::SerializedMessage serialized_message(0u);
    using MessageT = autoware_auto_msgs::msg::HADMapBin;
    static rclcpp::Serialization<MessageT> _lf_serializer;
    _lf_serializer.serialize_message(msg[3]->value.get() , &serialized_message);
    size_t _lf_message_length = serialized_message.size();
    lf_send_message(MSG_TYPE_P2P_MESSAGE, 1, 11, "federate 11", _lf_message_length, serialized_message.get_rcl_serialized_message().buffer);
  =}
}
